# Copy to .env.local. Real values live in Vercel's environment settings —
# never committed here, never pasted into chat.

# --- Postgres (Supabase) -------------------------------------------------
# Pooled connection as the restricted runtime role. RLS applies to this role
# in full. This is what application code uses, always.
DATABASE_URL=
# Pooled connection as the table-OWNER role. Postgres exempts table owners
# from RLS by design, so this is for migrations only — never imported by
# application code.
DATABASE_URL_MIGRATIONS=

# --- Postgres for the TEST SUITE (a different database from the above) ---
# `npm test` creates and deletes real rows, so it must never share a database
# with the dev server or manual walkthroughs — fixture users left behind by a
# crashed run would show up as real accountants in dev notification
# recipient lists. Same two-role shape as above, on a separate Supabase
# project (or any Postgres): DATABASE_URL_TEST is the restricted runtime role,
# DATABASE_URL_MIGRATIONS_TEST the table owner. The suite refuses to start if
# either is unset or names the same database as the dev URLs. Provisioning
# and migration: docs/test-database.md.
DATABASE_URL_TEST=
DATABASE_URL_MIGRATIONS_TEST=

# --- Auth (hand-rolled: argon2id passwords, DB-backed sessions, TOTP MFA) -
# Signs the session cookie's integrity check. Sessions themselves are opaque,
# revocable tokens in Postgres — this does not make them a JWT.
# Generate with `openssl rand -base64 32`.
SESSION_SECRET=
# AES-256-GCM key encrypting stored TOTP seeds at rest. Separate from
# BANK_ACCOUNT_ENCRYPTION_KEY so rotating one never touches the other.
# Generate with `openssl rand -base64 32`.
MFA_ENCRYPTION_KEY=

# --- Bill storage (Cloudflare R2) ---------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Extraction (Anthropic) ---------------------------------------------
# Without this, extraction must fail visibly on the health surface — never
# silently produce empty fields with no explanation.
ANTHROPIC_API_KEY=

# --- Email (Resend) ------------------------------------------------------
# EMAIL_FROM must use a domain verified in the Resend dashboard, formatted
# as "Name <address@your-domain.com>". Deliberately unset in CI.
RESEND_API_KEY=
EMAIL_FROM=

# --- Web Push (VAPID) ----------------------------------------------------
# Generate with `npx web-push generate-vapid-keys`. A different pair per
# environment. The public key is client-side; the private key never is.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Vendor bank encryption ---------------------------------------------
# AES-256-GCM key. Generate with `openssl rand -base64 32`. Rotating this
# makes previously encrypted account numbers undecryptable — treat it as a
# database credential, not a config toggle.
BANK_ACCOUNT_ENCRYPTION_KEY=

# --- Error tracking ------------------------------------------------------
SENTRY_DSN=
